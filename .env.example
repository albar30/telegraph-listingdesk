# ListingDesk — Telegraph Hackathon Season II, Mission 01 (Exchange)
# Copy to .env and fill only what you use. NEVER commit a filled .env.

# --- Transport: direct | apikey | x402 (default: direct) ---
# direct : calls the live miners' public endpoints. Real answers, $0, NOT a
#          Telegraph purchase. For development and demos only.
# apikey : PAID. Asks the Telegraph node through your Anjoman account
#          (recommended — the working V2 path since 19 Nov 2026).
# x402   : PAID. Pays each ask straight from a burner wallet with test USDC
#          on Base Sepolia via the x402 protocol.
TELEGRAPH_TRANSPORT=direct

# --- Anjoman API key (apikey transport only) ---
# Create at https://anjoman.ai/dashboard/api-keys and fund the account there
# (test USDC faucet: https://anjoman.ai/dashboard/faucet).
# NEVER paste the key into chat, and never commit it.
# TELEGRAPH_API_KEY=anjoman_...

# --- Burner wallet (x402 transport only) ---
# Fresh burner key, funded with Base Sepolia test USDC only.
# Get test USDC at https://faucet.circle.com (Base Sepolia).
# NEVER use a wallet that holds real funds.
# TELEGRAPH_PAYER_KEY=0x...

# --- Spending limits (USD, testnet). The app refuses to exceed them. ---
TELEGRAPH_MAX_ASK_USD=0.50
TELEGRAPH_DAILY_LIMIT_USD=5.00

# --- Endpoints (defaults are the live Telegraph testnet) ---
TELEGRAPH_NODE_URL=https://devnode.telegraphprotocol.com
TELEGRAPH_API_URL=https://backend.telegraphprotocol.com

# --- Server ---
PORT=8787
